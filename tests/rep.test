source [file join [file dirname [file normalize [info script]]] setup.tcl]

proc recvAll {s} {
    set frames [list [zmq::recv $s]]
    while {[zmq::getsockopt $s ZMQ_RCVMORE]} {
        lappend frames [zmq::recv $s]
    }
    return $frames
}

proc sendAll {s frames} {
    foreach f [lrange $frames 0 end-1] {
        zmq::send $s $f ZMQ_SNDMORE
    }
    zmq::send $s [lindex $frames end]
}

set setup {set ctx [zmq::ctx_new]}
set cleanup {zmq::ctx_term $ctx}

test rep-1.1 {echo a request with an empty delimiter} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    sendAll $d {{} ping}
    zmq::send $r [zmq::recv $r]
    recvAll $d
} -cleanup $cleanup -result {{} ping}

test rep-1.2 {envelope is kept and returned unchanged} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    sendAll $d {hop1 hop2 {} body}
    set req [recvAll $r]
    sendAll $r {reply}
    list $req [recvAll $d]
} -cleanup $cleanup -result {body {hop1 hop2 {} reply}}

test rep-1.3 {multipart request and reply} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    sendAll $d {{} a b c}
    set req [recvAll $r]
    sendAll $r {x y}
    list $req [recvAll $d]
} -cleanup $cleanup -result {{a b c} {{} x y}}

test rep-1.4 {a second request is answered after the first reply} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    set out {}
    foreach n {1 2} {
        sendAll $d [list {} req$n]
        lappend out [zmq::recv $r]
        zmq::send $r rep$n
        lappend out [recvAll $d]
    }
    set out
} -cleanup $cleanup -result {req1 {{} rep1} req2 {{} rep2}}

test rep-1.5 {recv twice without a reply fails with EFSM} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    sendAll $d {{} one}
    zmq::recv $r
    zmqerr {zmq::recv $r}
} -cleanup $cleanup -result {ZMQ EFSM}

test rep-1.6 {send without a request fails with EFSM} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    zmqerr {zmq::send $r reply}
} -cleanup $cleanup -result {ZMQ EFSM}

test rep-1.7 {send after a reply completed fails with EFSM} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    zmq::send $d {} ZMQ_SNDMORE
    zmq::send $d req
    zmq::recv $r
    zmq::send $r rep
    zmqerr {zmq::send $r again}
} -cleanup $cleanup -result {ZMQ EFSM}

test rep-1.8 {messages without an empty delimiter are dropped} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    zmq::send $d nodelim
    zmq::send $d {} ZMQ_SNDMORE
    zmq::send $d valid
    zmq::recv $r
} -cleanup $cleanup -result valid

test rep-1.9 {POLLOUT only while a reply is due} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    pipePair $r $d
    set pollout [zmq::const ZMQ_POLLOUT]
    set before [expr {[zmq::getsockopt $r ZMQ_EVENTS] & $pollout}]
    zmq::send $d {} ZMQ_SNDMORE
    zmq::send $d req
    zmq::recv $r
    list $before [expr {[zmq::getsockopt $r ZMQ_EVENTS] & $pollout}]
} -cleanup $cleanup -result {0 2}

test rep-1.10 {reply is dropped when the requesting peer is gone} -setup $setup -body {
    set r [zmq::socket $ctx ZMQ_REP]
    set d [zmq::socket $ctx ZMQ_DEALER]
    lassign [pipePair $r $d] rc dc
    zmq::send $d {} ZMQ_SNDMORE
    zmq::send $d req
    zmq::recv $r
    zmq::Detach $rc
    zmq::send $r rep
    zmqerr {zmq::send $r again}
} -cleanup $cleanup -result {ZMQ EFSM}

cleanupTests
