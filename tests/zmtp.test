source [file join [file dirname [file normalize [info script]]] setup.tcl]

proc hex {bytes} {
    binary scan $bytes H* h
    return $h
}

test zmtp-1.1 {greeting layout} {
    set g [zmq::zmtp::greeting NULL 0]
    list [string length $g] [hex [string range $g 0 11]] [string trimright [string range $g 12 31] \0]
} {64 ff00000000000000007f0301 NULL}

test zmtp-1.2 {greeting roundtrip} {
    zmq::zmtp::parse_greeting [zmq::zmtp::greeting PLAIN 1 0]
} {major 3 minor 0 mechanism PLAIN as_server 1}

test zmtp-1.3 {bad signature} {
    zmqerr {zmq::zmtp::parse_greeting [string repeat \0 64]}
} {ZMTP PROTOCOL}

test zmtp-1.4 {short greeting} {
    zmqerr {zmq::zmtp::parse_greeting abc}
} {ZMTP PROTOCOL}

test zmtp-2.1 {short frame encoding} {
    hex [zmq::zmtp::frame abc 1]
} 0103616263

test zmtp-2.2 {long frame encoding} {
    set f [zmq::zmtp::frame [string repeat x 300]]
    list [string length $f] [hex [string range $f 0 8]]
} {309 02000000000000012c}

test zmtp-2.3 {frame roundtrip} {
    set d [zmq::zmtp::parse_frame [zmq::zmtp::frame hello 1]tail]
    list [dict get $d more] [dict get $d command] [dict get $d body] [dict get $d length]
} {1 0 hello 7}

test zmtp-2.4 {long frame roundtrip} {
    set body [string repeat ab 200]
    expr {[dict get [zmq::zmtp::parse_frame [zmq::zmtp::frame $body]] body] eq $body}
} 1

test zmtp-2.5 {incomplete frame} {
    set f [zmq::zmtp::frame hello]
    list [zmq::zmtp::parse_frame ""] [zmq::zmtp::parse_frame [string range $f 0 3]]
} {{} {}}

test zmtp-2.6 {reserved flag bits} {
    zmqerr {zmq::zmtp::parse_frame [binary format cc 0x10 0]}
} {ZMTP PROTOCOL}

test zmtp-2.7 {command with MORE is invalid} {
    zmqerr {zmq::zmtp::parse_frame [binary format cc 5 0]}
} {ZMTP PROTOCOL}

test zmtp-2.8 {parse at an offset} {
    set buf [zmq::zmtp::frame a 1][zmq::zmtp::frame [string repeat b 300]][zmq::zmtp::frame c]
    set first [zmq::zmtp::parse_frame $buf]
    set second [zmq::zmtp::parse_frame $buf [dict get $first length]]
    set third [zmq::zmtp::parse_frame $buf [expr {[dict get $first length] + [dict get $second length]}]]
    list [dict get $first body] [string length [dict get $second body]] [dict get $second length] \
        [dict get $third body] [zmq::zmtp::parse_frame $buf [string length $buf]]
} {a 300 309 c {}}

test zmtp-3.1 {READY command roundtrip} {
    set d [zmq::zmtp::parse_frame [zmq::zmtp::ready ROUTER {Identity abc}]]
    set cmd [zmq::zmtp::parse_command [dict get $d body]]
    list [dict get $d command] [dict get $cmd name] \
        [zmq::zmtp::parse_metadata [dict get $cmd data]]
} {1 READY {Socket-Type ROUTER Identity abc}}

test zmtp-3.2 {malformed metadata} {
    zmqerr {zmq::zmtp::parse_metadata [binary format c 3]abc\0\0}
} {ZMTP PROTOCOL}

test zmtp-4.1 {socket type compatibility (RFC 37)} {
    list [zmq::zmtp::compatible ROUTER DEALER] [zmq::zmtp::compatible REQ REP] \
        [zmq::zmtp::compatible PUB PUB] [zmq::zmtp::compatible PUSH SUB]
} {1 1 0 0}

test zmtp-4.2 {type names} {
    list [zmq::zmtp::type_name 6] [zmqerr {zmq::zmtp::type_name 42}]
} {ROUTER {ZMTP PROTOCOL}}

cleanupTests
