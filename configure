#!/bin/sh
# Generate config.mk for the Makefile (install locations, tclsh).

prefix=/usr/local
libdir=
tclsh=tclsh9.0

usage() {
    cat <<EOF
Usage: ./configure [options]

  --prefix=DIR       install under DIR [/usr/local]
  --libdir=DIR       Tcl package directory [PREFIX/lib]
  --with-tclsh=PATH  tclsh used for tests [tclsh9.0]
  -h, --help         show this help
EOF
}

for arg in "$@"; do
    case "$arg" in
        --prefix=*)     prefix=${arg#*=} ;;
        --libdir=*)     libdir=${arg#*=} ;;
        --with-tclsh=*) tclsh=${arg#*=} ;;
        -h|--help)      usage; exit 0 ;;
        *)              echo "configure: unknown option: $arg" >&2; usage >&2; exit 1 ;;
    esac
done

[ -n "$libdir" ] || libdir=$prefix/lib

srcdir=$(cd "$(dirname "$0")" && pwd)
version=$(sed -n 's/.*package ifneeded zmq \([0-9.]*\).*/\1/p' "$srcdir/lib/zmq/pkgIndex.tcl")
if [ -z "$version" ]; then
    echo "configure: cannot determine package version from lib/zmq/pkgIndex.tcl" >&2
    exit 1
fi

cat > "$srcdir/config.mk" <<EOF
# Generated by ./configure $*
PREFIX  = $prefix
LIBDIR  = $libdir
VERSION = $version
TCLSH   = $tclsh
EOF

echo "configure: zmq $version will be installed in $libdir/zmq$version"
echo "configure: wrote config.mk"
